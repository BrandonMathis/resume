  "title": "Fixes API Blueprint route's always grouping",
  "user": {
    "login": "BrandonMathis",
    "id": 362269,
    "node_id": "MDQ6VXNlcjM2MjI2OQ==",
    "avatar_url": "https://avatars.githubusercontent.com/u/362269?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/BrandonMathis",
    "html_url": "https://github.com/BrandonMathis",
    "followers_url": "https://api.github.com/users/BrandonMathis/followers",
    "following_url": "https://api.github.com/users/BrandonMathis/following{/other_user}",
    "gists_url": "https://api.github.com/users/BrandonMathis/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/BrandonMathis/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/BrandonMathis/subscriptions",
    "organizations_url": "https://api.github.com/users/BrandonMathis/orgs",
    "repos_url": "https://api.github.com/users/BrandonMathis/repos",
    "events_url": "https://api.github.com/users/BrandonMathis/events{/privacy}",
    "received_events_url": "https://api.github.com/users/BrandonMathis/received_events",
    "type": "User",
